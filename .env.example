# Copy to .env and fill in. Server-only: never prefix these with VITE_.
# Apps Script web app URLs (Deploy > Manage deployments, end in /exec)
# enquiries: scripts/contact-form.gs
APPS_SCRIPT_URL=
# pass applications: scripts/application-form.gs
APPLICATIONS_SCRIPT_URL=
# Shared secret, must match FORM_SECRET in both Apps Scripts' Script Properties (openssl rand -hex 24)
FORM_SECRET=
